# Porta do servidor Express
PORT=3000

# Destino para onde o webhook recebido sera reencaminhado (payload identico)
DEST_URL=https://apipix-delta.vercel.app/api/webhook/axxon

# Supabase - projeto -> Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# ATENCAO: service_role key. NUNCA exponha no frontend / repositorio publico.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# Segredo do JWT da sessao (gere com: openssl rand -hex 32)
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Nome do cookie de sessao (opcional)
COOKIE_NAME=axxon_session
# Envia o cookie apenas por HTTPS. Use true em producao (dominio com SSL).
COOKIE_SECURE=false
# Validade do token de sessao
JWT_EXPIRES_IN=12h

# Ambiente
NODE_ENV=development
