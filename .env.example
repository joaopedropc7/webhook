# Porta do servidor Express
PORT=3000

# Destino para onde o webhook recebido sera reencaminhado (payload identico)
DEST_URL=https://apipix-delta.vercel.app/api/webhook/axxon

# Supabase - projeto -> Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# ATENCAO: service_role key. NUNCA exponha no frontend / repositorio publico.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# Segredo do JWT da sessao (gere com: openssl rand -hex 32)
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Nome do cookie de sessao (opcional)
COOKIE_NAME=axxon_session
# Envia o cookie apenas por HTTPS. Deixe VAZIO para automatico:
# true em producao/Vercel, false em local (http). Preencha so para forcar.
COOKIE_SECURE=
# Validade do token de sessao
JWT_EXPIRES_IN=12h

# Usuario padrao criado no primeiro boot, se a tabela users estiver vazia.
# Troque a senha em Configuracoes assim que entrar no painel.
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=password

# Reenvio: pior caso = (FORWARD_MAX_RETRIES + 1) * FORWARD_TIMEOUT_MS + backoff.
# Em serverless (Vercel/Lambda), reduza para caber no limite de execucao.
FORWARD_TIMEOUT_MS=10000
FORWARD_MAX_RETRIES=2

# Ambiente
NODE_ENV=development
